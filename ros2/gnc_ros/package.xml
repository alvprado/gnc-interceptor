<?xml version="1.0"?>
<package format="3">
  <name>gnc_ros</name>
  <version>0.1.0</version>
  <description>Composable ROS2 node adapters for the GNC libraries.</description>
  <maintainer email="alvarezprado96@gmail.com">Andres Alvarez</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>autodiff</depend>
  <depend>builtin_interfaces</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>gnc_interfaces</depend>
  <depend>message_filters</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rcl_interfaces</depend>
  <depend>rclcpp_components</depend>
  <depend>rosgraph_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>gtest</test_depend>
  <test_depend>tf2_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
