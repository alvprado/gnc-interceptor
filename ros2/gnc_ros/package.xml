<?xml version="1.0"?>
<package format="3">
  <name>gnc_ros</name>
  <version>0.1.0</version>
  <description>Composable ROS2 node adapters for the GNC libraries.</description>
  <maintainer email="alvarezprado96@gmail.com">Andres Alvarez</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>gnc_core</depend>
