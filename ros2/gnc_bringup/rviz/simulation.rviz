Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 245; 245; 245
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid
      Enabled: true
      Cell Size: 10
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: GNC markers
      Enabled: true
      Namespaces: {}
      Topic:
        Value: /visualization/markers
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Filter size: 10
      Value: true
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 280
      Target Frame: world
      Focal Point:
        X: 60
        Y: 50
        Z: 60
      Pitch: 0.7
      Yaw: 2.164343
    Saved:
      - Class: rviz_default_plugins/Orbit
        Name: Overview
        Target Frame: world
        Distance: 450
        Focal Point:
          X: 60
          Y: 50
          Z: 60
        Pitch: 0.7
        Yaw: 2.164343
Window Geometry:
  Width: 1280
  Height: 800
